<Project>

  <!--
    One version for the packages built from this folder: z3l.FastHtmlParser and its HtmlToMarkdown, HtmlSanitizer and
    Readability packages are released together, and these three depend on z3l.FastHtmlParser of the same version.
    CI takes the version from the tag (-p:Version=...), this one is for untagged builds.
  -->
  <PropertyGroup>
    <Version>1.8.2</Version>
  </PropertyGroup>

</Project>
