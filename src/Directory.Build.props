<Project>

  <!--
    One version for the packages built from this folder: z3l.FastHtmlParser and z3l.FastHtmlParser.HtmlToMarkdown
    are released together, and the second depends on the first of the same version.
    CI takes the version from the tag (-p:Version=...), this one is for untagged builds.
  -->
  <PropertyGroup>
    <Version>1.6.0</Version>
  </PropertyGroup>

</Project>
