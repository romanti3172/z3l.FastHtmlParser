<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The package that is found by "html sanitizer". The sanitizer is a part of z3l.FastHtmlParser (it reads the tags as
    the parser recorded them); this assembly has one class that calls it, and the package depends on z3l.FastHtmlParser
    of the same version.
    Keep it to that class: the packages are used together, and a second type or an extension method here
    could get the name of one in the parser.
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>z3l.FastHtmlParser.HtmlSanitizer</AssemblyName>
    <!-- The class is in the namespace of the parser: one "using" for both packages, and its full name is the package name. -->
    <RootNamespace>z3l.FastHtmlParser</RootNamespace>

    <!-- Turns on the trimming / Native AOT analyzers; no effect on the produced code. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- NuGet package. The version is in ..\Directory.Build.props: one for all the packages of this folder. -->
  <PropertyGroup>
    <PackageId>z3l.FastHtmlParser.HtmlSanitizer</PackageId>
    <Title>Fast HTML Sanitizer</Title>
    <Authors>z3l</Authors>
    <Copyright>Copyright © 2026 z3l</Copyright>
    <Description>Fast HTML sanitizer for .NET 9/10/11 against XSS, built on z3l.FastHtmlParser: keeps only the allowed tags, attributes, URL schemes and CSS properties of untrusted HTML (comments, posts, e-mails, scraped pages) and writes the result anew, with every text and attribute escaped and every element closed. No AngleSharp dependency; linear time on any markup.</Description>
    <PackageTags>html-sanitizer;htmlsanitizer;sanitizer;sanitize;sanitize-html;xss;xss-protection;anti-xss;security;html;html-cleaner;allowlist;whitelist;css;user-generated-content;fast;dotnet;csharp;net9;net10;net11;aot;fasthtmlparser;htmlsanitizer-alternative</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://htmlsanitizer.fasthtmlparser.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/romanti3172/z3l.FastHtmlParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/romanti3172/z3l.FastHtmlParser/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!--
      As in the parser: "dotnet pack" compares the public API with the last released package (downloaded from
      nuget.org) and fails on a breaking change. After each release set the baseline to the version just released.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.8.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- In the package this is the dependency on z3l.FastHtmlParser, not lower than this version. -->
  <ItemGroup>
    <ProjectReference Include="..\z3l.FastHtmlParser\z3l.FastHtmlParser.csproj" />
  </ItemGroup>

</Project>
