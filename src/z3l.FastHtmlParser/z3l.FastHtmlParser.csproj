<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 9+: FrozenDictionary/Dictionary AlternateLookup<ReadOnlySpan<char>> -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>z3l.FastHtmlParser</AssemblyName>
    <RootNamespace>z3l.FastHtmlParser</RootNamespace>

    <!-- Turns on the trimming / Native AOT analyzers; no effect on the produced code. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <PackageId>z3l.FastHtmlParser</PackageId>
    <Title>Fast HTML Parser</Title>
    <Version>1.1.4</Version>
    <Authors>z3l</Authors>
    <Copyright>Copyright © 2026 z3l</Copyright>
    <Description>Fast, low-allocation HTML/XML parser for web scraping on .NET 9/10. About 10x (up to 33x) faster and 12–23x less memory than AngleSharp and HtmlAgilityPack in benchmarks. Zero-allocation tag/attribute matching, HTML5 entities, clean HTML to text extraction.</Description>
    <PackageTags>html;parser;html-parser;htmlparser;fasthtmlparser;fast-html-parser;htmlscraper;html-scraper;scraping;crawler;xml;rss;sitemap;html5;entities;span;performance;web;web-scraping;webscraping;scraper;text;html-to-text;htmltotext;text-extraction;dom;fast;low-allocation;zero-allocation;dotnet;csharp;net9;net10;aot;htmlagilitypack-alternative;anglesharp-alternative</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://romanti3172.github.io/z3l.FastHtmlParser/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/romanti3172/z3l.FastHtmlParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="z3l.FastHtmlParser.Tests" />
  </ItemGroup>

</Project>
