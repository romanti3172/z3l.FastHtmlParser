<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 9+: FrozenDictionary/Dictionary AlternateLookup<ReadOnlySpan<char>> -->
    <TargetFrameworks>net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>z3l.FastHtmlParser</AssemblyName>
    <RootNamespace>z3l.FastHtmlParser</RootNamespace>

    <!-- Turns on the trimming / Native AOT analyzers; no effect on the produced code. -->
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- NuGet package. The version is in ..\Directory.Build.props: one for this package and z3l.FastHtmlParser.HtmlToMarkdown. -->
  <PropertyGroup>
    <PackageId>z3l.FastHtmlParser</PackageId>
    <Title>Fast HTML Parser</Title>
    <Authors>z3l</Authors>
    <Copyright>Copyright © 2026 z3l</Copyright>
    <Description>Fast, low-allocation HTML/XML parser for web scraping on .NET 9/10/11. About 10x (up to 30x) faster and 12–23x less memory than AngleSharp and HtmlAgilityPack in benchmarks. XPath 1.0 and CSS selectors, zero-allocation tag/attribute matching, HTML5 entities, clean HTML to text extraction, HTML to Markdown.</Description>
    <PackageTags>html;parser;html-parser;htmlparser;fasthtmlparser;fast-html-parser;htmlscraper;html-scraper;xpath;html-xpath;xpath-query;css;css-selector;css-selectors;queryselector;queryselectorall;scraping;crawler;xml;rss;sitemap;html5;entities;span;performance;web;web-scraping;webscraping;scraper;text;html-to-text;htmltotext;text-extraction;markdown;html-to-markdown;htmltomarkdown;html2markdown;dom;fast;low-allocation;zero-allocation;dotnet;csharp;net9;net10;net11;aot;htmlagilitypack-alternative;anglesharp-alternative</PackageTags>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://fasthtmlparser.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/romanti3172/z3l.FastHtmlParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/romanti3172/z3l.FastHtmlParser/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!--
      "dotnet pack" compares the public API with the last released package (downloaded from nuget.org)
      and fails on a breaking change: a removed or changed public member, a dropped target framework.
      After each release set the baseline to the version just released.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.8.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="z3l.FastHtmlParser.Tests" />
  </ItemGroup>

</Project>
